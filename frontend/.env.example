# Frontend environment variables (Vite). Copy to `.env.local` to override locally.
#
# Backend chat endpoint.
#  - Local development: leave unset. The default "/api/chat" is proxied by the Vite
#    dev server to http://localhost:8000 (see vite.config.ts).
#  - Production: set to the full backend URL.
# VITE_API_URL=http://localhost:8000/api/chat
