# Production build configuration (committed, so it must never contain secrets).
#
# Set VITE_API_URL to the FULL URL of your deployed backend chat endpoint, e.g.
#   VITE_API_URL=https://your-backend.example.com/api/chat
# You can instead define it in your hosting provider's environment settings
# (for example Vercel -> Project Settings -> Environment Variables), which takes
# precedence over this file.
#
# If left unset, the app falls back to the same-origin path "/api/chat".
# VITE_API_URL=